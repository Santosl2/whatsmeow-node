{
    "name": "whatsmeow-node",
    "version": "0.1.3",
    "description": "TypeScript N-API bindings for go.mau.fi/whatsmeow via Go c-shared bridge",
    "license": "MPL-2.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "repository": "https://github.com/vinikjkkj/whatsmeow-node",
    "files": [
        "src",
        "dist",
        "prebuilt",
        "proto",
        "scripts/*.mjs"
    ],
    "scripts": {
        "build:go": "node ./scripts/build-go.mjs",
        "gen:protos": "node ./scripts/generate-protos.mjs",
        "build:ts": "tsc",
        "build": "npm run build:go && npm run build:ts",
        "postinstall": "node ./scripts/postinstall.mjs",
        "clean": "rimraf dist build"
    },
    "dependencies": {
        "ioredis": "^5.8.2",
        "koffi": "^2.9.0",
        "protobufjs": "^7.5.4"
    },
    "devDependencies": {
        "@types/node": "^22.5.4",
        "fast-glob": "^3.3.2",
        "prettier": "^3.6.2",
        "protobufjs-cli": "^1.1.1",
        "rimraf": "^6.0.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=18"
    }
}
